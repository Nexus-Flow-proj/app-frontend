VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:3000

# Leave empty locally to use the Vite /socket.io proxy.
# Set this in deployment to the backend origin.
VITE_SOCKET_URL=

# Optional deploy fallback when the host refuses WebSocket upgrades.
# Leave empty for Socket.IO default polling + websocket upgrade.
VITE_SOCKET_TRANSPORT=
