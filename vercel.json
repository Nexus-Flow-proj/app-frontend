{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nexus-flow-backend.up.railway.app//api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://nexus-flow-backend.up.railway.app//socket.io/:path*"
    },
    {
      "source": "/socket.io",
      "destination": "https://nexus-flow-backend.up.railway.app//socket.io"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
