{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://app-backend-production-1306.up.railway.app/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://app-backend-production-1306.up.railway.app/socket.io/:path*"
    },
    {
      "source": "/socket.io",
      "destination": "https://app-backend-production-1306.up.railway.app/socket.io"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
